{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "Payments": {
    "DefaultProvider": "Paystack",
    "PayoutProvider": "Paystack",
    "DefaultCurrency": "ngn",
    "PlatformCommissionPercent": 12,
    "CheckoutRoutingMode": "AuthorPreference",
    "PaystackCountryCodes": [ "NG", "GH", "ZA", "KE" ],
    "ReaderSubscriptionsEnabled": false
  },
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": ""
  },
  "Paystack": {
    "SecretKey": "",
    "PublicKey": "",
    "WebhookSecret": "",
    "BaseUrl": "https://api.paystack.co",
    "BulkTransfersEnabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
