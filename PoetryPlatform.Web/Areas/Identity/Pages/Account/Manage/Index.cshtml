@page
@model PoetryPlatform.Web.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Manage Account";
}

<h3>Manage your account</h3>

<partial name="_StatusMessage" model="StatusMessage" />


<form method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Username</label>
        <input class="form-control" value="@Model.Username" disabled />
    </div>

    <div class="mb-3">
        <label class="form-label">Author / Pen Name</label>
        <input name="Input.AuthorName"
               value="@Model.Input.AuthorName"
               class="form-control" />

        <small class="text-muted">
            This name will be displayed on your writings
        </small>
    </div>

    <div class="mb-3">
        <label class="form-label">Phone number</label>
        <input name="Input.PhoneNumber"
               value="@Model.Input.PhoneNumber"
               class="form-control" />

    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>
</form>
