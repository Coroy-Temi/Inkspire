@model PoetryPlatform.Web.Models.PoemReadVm
@using System.Security.Claims
@using PoetryPlatform.Web.Models.Payments
@inject Microsoft.Extensions.Options.IOptions<PoetryPlatform.Web.Models.Payments.PaymentPlatformOptions> PaymentOptions

@{
    ViewData["Title"] = Model.Poem.Title;
    var commentCount = Model.Poem.Comments.Count(c => !c.IsDeleted);
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var displayCurrency = PaymentOptions.Value.DefaultCurrency.ToUpperInvariant();
    var accessLabel = Model.Poem.AccessType switch
    {
        ContentAccessType.PlatformPaid => $"Platform Paid - {displayCurrency} {Model.Poem.Price:0.##}",
        ContentAccessType.ExternalLink => "External Storefront",
        _ => "Free To Read"
    };
    var canViewAttachedPdf = !string.IsNullOrEmpty(Model.Poem.PdfPath)
        && (Model.ViewerOwnsPoem
            || Model.Poem.AccessType == ContentAccessType.Free
            || (Model.Poem.AccessType == ContentAccessType.PlatformPaid && Model.HasPurchasedAccess));
    var hasGatedPdf = !string.IsNullOrEmpty(Model.Poem.PdfPath) && !canViewAttachedPdf;
    var currentPageContent = Model.Pages[Model.CurrentPage - 1];
    var checkoutStatusMessage = TempData["CheckoutStatusMessage"] as string;
    var authorName = string.IsNullOrWhiteSpace(Model.Poem.Author?.AuthorName) ? Model.Poem.Author?.UserName : Model.Poem.Author?.AuthorName;
    var authorAvatarText = string.IsNullOrWhiteSpace(authorName) ? "I" : authorName.Substring(0, 1).ToUpperInvariant();
}

@if (!string.IsNullOrWhiteSpace(checkoutStatusMessage))
{
    <div class="notice-card mb-4">
        <strong>Checkout update</strong>
        <p class="mb-0">@checkoutStatusMessage</p>
    </div>
}

<section class="reader-hero">
    <div>
        <span class="pill-label">@accessLabel</span>
        <h1>@Model.Poem.Title</h1>
        <div class="author-line author-line--hero">
            @if (!string.IsNullOrWhiteSpace(Model.Poem.Author?.ProfileImagePath))
            {
                <img src="@Model.Poem.Author.ProfileImagePath" alt="@authorName" class="author-avatar author-avatar--large" />
            }
            else
            {
                <span class="author-avatar author-avatar--fallback author-avatar--large">@authorAvatarText</span>
            }
            <p class="reader-author">by @authorName</p>
        </div>
    </div>

    <div class="reader-meta-grid">
        <article class="stat-card">
            <strong>@Model.Poem.Views</strong>
            <span>Reads</span>
        </article>
        <article class="stat-card">
            <strong data-like-count>@Model.LikeCount</strong>
            <span>Likes</span>
        </article>
        <article class="stat-card">
            <strong>@commentCount</strong>
            <span>Comments</span>
        </article>
    </div>
</section>

<section class="reader-layout">
    <article class="reader-panel">
        @if (!string.IsNullOrWhiteSpace(Model.Poem.Content))
        {
            <div class="poem-shell" data-reader-shell>
                <div class="poem-shell__toolbar">
                    <div>
                        <span class="eyebrow">Reading view</span>
                        <h2>Experience the writing as a page</h2>
                    </div>
                    <div class="preview-controls preview-controls--reader">
                        <button type="button" class="pill-button active" data-reader-font="classic">Classic</button>
                        <button type="button" class="pill-button" data-reader-font="book">Book</button>
                        <button type="button" class="pill-button" data-reader-font="modern">Modern</button>
                        <button type="button" class="pill-button" data-reader-fullscreen>Full screen</button>
                    </div>
                </div>

                <div class="reader-settings">
                    <label class="reader-settings__item">
                        <span>Text size</span>
                        <input type="range" min="16" max="28" value="19" data-reader-size />
                    </label>
                    <div class="reader-settings__item">
                        <span>Page width</span>
                        <button type="button" class="pill-button active" data-reader-width="narrow">Focused</button>
                        <button type="button" class="pill-button" data-reader-width="wide">Open</button>
                    </div>
                </div>

                <div class="page-progress">
                    <span>Page @Model.CurrentPage of @Model.TotalPages</span>
                    @if (Model.TotalPages > 1)
                    {
                        <div class="page-dots">
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <a class="page-dot @(i == Model.CurrentPage ? "active" : null)" asp-action="Read" asp-route-id="@Model.Poem.Id" asp-route-page="@i">@i</a>
                            }
                        </div>
                    }
                </div>

                <div class="poem-body poem-body--classic" data-reader-body>@currentPageContent</div>

                @if (Model.TotalPages > 1)
                {
                    <div class="page-navigation">
                        @if (Model.CurrentPage > 1)
                        {
                            <a class="btn btn-brand btn-brand--ghost" asp-action="Read" asp-route-id="@Model.Poem.Id" asp-route-page="@(Model.CurrentPage - 1)">Previous Page</a>
                        }
                        else
                        {
                            <span></span>
                        }

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a class="btn btn-brand" asp-action="Read" asp-route-id="@Model.Poem.Id" asp-route-page="@(Model.CurrentPage + 1)">Next Page</a>
                        }
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Poem.PdfPath) && canViewAttachedPdf)
        {
            <div class="pdf-shell">
                <div class="section-heading">
                    <div>
                        <span class="eyebrow">Attached edition</span>
                        <h2>Read the PDF edition</h2>
                    </div>
                    <a class="btn btn-brand btn-brand--ghost" href="@Model.Poem.PdfPath" target="_blank" rel="noopener noreferrer">Open in new tab</a>
                </div>
                <iframe src="@Model.Poem.PdfPath" class="pdf-viewer" loading="lazy"></iframe>
            </div>
        }
    </article>

    <aside class="reader-sidebar">
        <div class="glass-card sidebar-panel">
            <span class="eyebrow">Reader actions</span>
            <form asp-action="ToggleLike" method="post" class="d-grid gap-3" data-like-form>
                @Html.AntiForgeryToken()
                <input type="hidden" name="poemId" value="@Model.Poem.Id" />
                <button type="submit" class="btn btn-brand @(Model.UserHasLiked ? "" : "btn-brand--ghost")" data-like-button data-liked="@Model.UserHasLiked.ToString().ToLowerInvariant()">
                    @(Model.UserHasLiked ? "Unlike this piece" : "Like this piece")
                </button>
            </form>
            <p class="muted-copy">Show appreciation without losing your place in the reading flow.</p>
        </div>

        <div class="glass-card sidebar-panel">
            <span class="eyebrow">Book access</span>
            @if (Model.Poem.AccessType == ContentAccessType.PlatformPaid)
            {
                <h2>@displayCurrency @Model.Poem.Price.ToString("0.##")</h2>

                @if (Model.ViewerOwnsPoem)
                {
                    <p>This is your release, so the full attached edition stays available while you review the reader experience.</p>
                }
                else if (Model.HasPurchasedAccess)
                {
                    <p>Your purchase is confirmed. The attached edition is unlocked for this account.</p>
                    @if (Model.LatestOrderId.HasValue)
                    {
                        <div class="d-grid gap-3">
                            <a class="btn btn-brand" asp-controller="Checkout" asp-action="Receipt" asp-route-orderId="@Model.LatestOrderId.Value">View receipt</a>
                            <a class="btn btn-brand btn-brand--ghost" asp-controller="Checkout" asp-action="History">Purchase history</a>
                        </div>
                    }
                }
                else
                {
                    <p>Continue reading the preview here, then unlock the attached edition through checkout.</p>

                    <form asp-controller="Checkout" asp-action="Start" method="post" class="d-grid gap-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="poemId" value="@Model.Poem.Id" />
                        <button type="submit" class="btn btn-brand">Unlock PDF access</button>
                    </form>

                    @if (Model.LatestOrderStatus == OrderStatus.CheckoutCreated && !string.IsNullOrWhiteSpace(Model.LatestCheckoutUrl))
                    {
                        <a class="btn btn-brand btn-brand--ghost mt-3" href="@Model.LatestCheckoutUrl">Resume checkout</a>
                    }
                    else if (Model.LatestOrderStatus == OrderStatus.Failed)
                    {
                        <div class="notice-card mt-3">
                            <strong>Payment needs attention</strong>
                            <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.LatestFailureReason) ? "A payment attempt did not complete. You can try again after checking your payment setup." : Model.LatestFailureReason)</p>
                        </div>
                    }
                    else if (Model.LatestOrderStatus == OrderStatus.Cancelled)
                    {
                        <p class="muted-copy mt-3">That checkout was cancelled. Start again whenever you are ready.</p>
                    }
                }
            }
            else if (Model.Poem.AccessType == ContentAccessType.ExternalLink && !string.IsNullOrWhiteSpace(Model.Poem.ExternalPurchaseUrl))
            {
                <h2>External storefront</h2>
                <p>Readers can continue to the author's purchase page while still discovering the work here first.</p>
                <a class="btn btn-brand" href="@Model.Poem.ExternalPurchaseUrl" target="_blank" rel="noopener noreferrer">Open purchase page</a>
            }
            else
            {
                <h2>Free access</h2>
                <p>This piece is fully readable on the platform and can still be discussed, liked, and shared.</p>
            }

            @if (hasGatedPdf)
            {
                <div class="notice-card mt-3">
                    <strong>Attached edition locked</strong>
                    <p class="mb-0">
                        @if (Model.Poem.AccessType == ContentAccessType.PlatformPaid)
                        {
                            <span>The PDF edition unlocks after a completed purchase.</span>
                        }
                        else
                        {
                            <span>The attached PDF is hidden here because this title is routed through an external storefront.</span>
                        }
                    </p>
                </div>
            }
        </div>
    </aside>
</section>

<section class="comments-shell">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Discussion</span>
            <h2>@commentCount comments</h2>
        </div>
    </div>

    <form asp-action="AddComment" method="post" class="glass-card comment-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="poemId" value="@Model.Poem.Id" />
        <input type="hidden" name="page" value="@Model.CurrentPage" />
        <label class="form-label" for="comment-content">Add your thought</label>
        <textarea id="comment-content" name="content" class="form-control" rows="4" maxlength="1000" placeholder="What stayed with you in this piece?" required></textarea>
        <div class="comment-form__actions">
            <span class="muted-mini">Keep it thoughtful. Flagging is enabled for harmful content.</span>
            <button type="submit" class="btn btn-brand">Post Comment</button>
        </div>
    </form>

    @if (Model.Poem.Comments.Any(c => !c.IsDeleted))
    {
        <div class="comment-stack">
            @foreach (var comment in Model.Poem.Comments.Where(c => !c.IsDeleted).OrderByDescending(c => c.CreatedAt))
            {
                var alreadyFlagged = Model.UserCommentFlags.Contains(comment.Id);
                <article class="comment-card">
                    <div class="comment-card__header">
                        <div>
                            <strong>@(string.IsNullOrWhiteSpace(comment.User?.AuthorName) ? comment.User?.UserName : comment.User?.AuthorName)</strong>
                            <span class="muted-mini">@comment.CreatedAt.ToLocalTime().ToString("g")</span>
                        </div>
                        <div class="comment-card__actions">
                            @if (User.IsInRole("Admin") || Model.Poem.AuthorId == userId)
                            {
                                <form asp-action="DeleteComment" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="commentId" value="@comment.Id" />
                                    <input type="hidden" name="page" value="@Model.CurrentPage" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this comment?');">Delete</button>
                                </form>
                            }
                            <form asp-action="FlagComment" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="commentId" value="@comment.Id" />
                                <input type="hidden" name="page" value="@Model.CurrentPage" />
                                <button class="btn btn-sm btn-outline-secondary" disabled="@(alreadyFlagged ? "disabled" : null)">@(alreadyFlagged ? "Flagged" : "Flag")</button>
                            </form>
                        </div>
                    </div>
                    <p class="mb-0">@comment.Content</p>
                </article>
            }
        </div>
    }
    else
    {
        <div class="empty-state">No comments yet. Be the first reader to leave a response.</div>
    }
</section>
