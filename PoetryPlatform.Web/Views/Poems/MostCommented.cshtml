@model IEnumerable<PoetryPlatform.Web.Models.MostCommentedPoemVm>

@{
    ViewData["Title"] = "Most Commented Poems";
}

<h2 class="mb-4">💬 Most Commented Poems</h2>

<div class="btn-group mb-4" role="group">
    <a asp-action="MostCommented"
       asp-route-days="0"
       class="btn btn-outline-primary @(ViewBag.Days == 0 ? "active" : "")">
        All Time
    </a>

    <a asp-action="MostCommented"
       asp-route-days="7"
       class="btn btn-outline-primary @(ViewBag.Days == 7 ? "active" : "")">
        Last 7 Days
    </a>

    <a asp-action="MostCommented"
       asp-route-days="30"
       class="btn btn-outline-primary @(ViewBag.Days == 30 ? "active" : "")">
        Last 30 Days
    </a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No poems have comments yet.</p>
}
else
{
    <!-- ========================= -->
    <!-- DESKTOP TABLE (md+) -->
    <!-- ========================= -->
    <table class="table table-striped align-middle d-none d-md-table">
        <thead>
            <tr>
                <th style="width:80px;">Rank</th>
                <th>Title</th>
                <th>Author</th>
                <th>Comments</th>
                <th>Published</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var poem in Model)
            {
                <tr>
                    <td class="text-center">
                        @if (poem.Rank == 1)
                        {
                            <span class="fs-4">🥇</span>
                        }
                        else if (poem.Rank == 2)
                        {
                            <span class="fs-4">🥈</span>
                        }
                        else if (poem.Rank == 3)
                        {
                            <span class="fs-4">🥉</span>
                        }
                        else
                        {
                            <strong>#@poem.Rank</strong>
                        }
                    </td>

                    <td>
                        <strong>
                            <a asp-controller="Poems"
                               asp-action="Read"
                               asp-route-id="@poem.Id">
                                @poem.Title
                            </a>
                        </strong>
                    </td>

                    <td>@poem.AuthorName</td>

                    <td>💬 @poem.CommentCount</td>

                    <td>@poem.CreatedAt.ToLocalTime().ToShortDateString()</td>

                    <td>
                        <a asp-controller="Poems"
                           asp-action="Read"
                           asp-route-id="@poem.Id"
                           class="btn btn-sm btn-outline-primary">
                            Read
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- ========================= -->
    <!-- MOBILE CARDS (< md) -->
    <!-- ========================= -->
    <div class="d-md-none">
        @foreach (var poem in Model)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-body">

                    <!-- RANK -->
                    <div class="mb-2">
                        @if (poem.Rank == 1)
                        {
                            <span class="fs-4">🥇</span>
                        }
                        else if (poem.Rank == 2)
                        {
                            <span class="fs-4">🥈</span>
                        }
                        else if (poem.Rank == 3)
                        {
                            <span class="fs-4">🥉</span>
                        }
                        else
                        {
                            <strong>#@poem.Rank</strong>
                        }
                    </div>

                    <!-- TITLE -->
                    <h5 class="mb-1">
                        <a asp-controller="Poems"
                           asp-action="Read"
                           asp-route-id="@poem.Id">
                            @poem.Title
                        </a>
                    </h5>

                    <!-- META -->
                    <small class="text-muted d-block mb-2">
                        by @poem.AuthorName · 💬 @poem.CommentCount comments
                    </small>

                    <!-- ACTION -->
                    <a asp-controller="Poems"
                       asp-action="Read"
                       asp-route-id="@poem.Id"
                       class="btn btn-sm btn-outline-primary w-100">
                        Read
                    </a>
                </div>
            </div>
        }
    </div>
}
