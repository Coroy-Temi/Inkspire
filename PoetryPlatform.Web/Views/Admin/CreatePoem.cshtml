@model PoetryPlatform.Web.Models.Poem

@{
    ViewData["Title"] = "Create Poem";
}

<h1>Create Poem</h1>

<form asp-action="CreatePoem" method="post">
    @Html.AntiForgeryToken()

    <div>
        <label asp-for="Title"></label>
        <input asp-for="Title" />
    </div>

    <div>
        <label asp-for="Content"></label>
        <textarea asp-for="Content" rows="8"></textarea>
    </div>

    <div>
        <label>Access Type</label>
        <select asp-for="AccessType"
                asp-items="Html.GetEnumSelectList<ContentAccessType>()">
        </select>
    </div>

    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" step="0.01" />
        <small>Only used for PlatformPaid</small>
    </div>

    <div>
        <label asp-for="ExternalPurchaseUrl"></label>
        <input asp-for="ExternalPurchaseUrl" />
        <small>Only used for ExternalLink</small>
    </div>

    <button type="submit">Publish</button>
</form>
