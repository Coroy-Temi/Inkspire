@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var pageClass = ViewData["PageClass"]?.ToString() ?? string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inkspire</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="@pageClass">
    <div class="site-backdrop"></div>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container site-shell">
                <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark__glyph">I</span>
                    <span>
                        <span class="brand-mark__title">Inkspire</span>
                        <span class="brand-mark__subtitle">Words. Presence. Publishing.</span>
                    </span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Poems" && currentAction == "Index" ? "active" : "")" asp-controller="Poems" asp-action="Index">Library</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Poems" && currentAction == "Trending" ? "active" : "")" asp-controller="Poems" asp-action="Trending">Trending</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Poems" && currentAction == "MostCommented" ? "active" : "")" asp-controller="Poems" asp-action="MostCommented">Conversations</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Writer" ? "active" : "")" asp-controller="Writer" asp-action="Poems">Author Studio</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(currentController == "Admin" || currentController == "AdminUsers" ? "active" : "")" role="button" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                                <ul class="dropdown-menu dropdown-menu-end glass-menu">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Payouts">Payouts</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">Users</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="FlaggedComments">Flagged Comments</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminUsers" asp-action="Create">Create Admin</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="nav-actions">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container site-shell site-main">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <button type="button" class="theme-switch" data-theme-toggle aria-label="Switch dark mode" aria-pressed="false">
        <span class="theme-switch__copy">
            <span class="theme-switch__label" data-theme-label>Dark mode</span>
            <span class="theme-switch__state" data-theme-state>Off</span>
        </span>
        <span class="theme-switch__track" aria-hidden="true">
            <span class="theme-switch__thumb" data-theme-thumb></span>
        </span>
    </button>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
