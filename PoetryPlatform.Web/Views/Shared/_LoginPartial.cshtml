@using Microsoft.AspNetCore.Identity
@using PoetryPlatform.Web.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = SignInManager.IsSignedIn(User)
        ? UserManager.GetUserAsync(User).GetAwaiter().GetResult()
        : null;
    var displayName = string.IsNullOrWhiteSpace(currentUser?.AuthorName)
        ? User.Identity?.Name
        : currentUser?.AuthorName;
    var avatarText = string.IsNullOrWhiteSpace(displayName) ? "I" : displayName.Substring(0, 1).ToUpperInvariant();
}

<ul class="navbar-nav align-items-lg-center gap-lg-2">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <span class="nav-link nav-link-greeting">Hi, @displayName</span>
    </li>
    <li class="nav-item dropdown">
        <a class="profile-avatar dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Account">
            @if (!string.IsNullOrWhiteSpace(currentUser?.ProfileImagePath))
            {
                <img src="@currentUser.ProfileImagePath" alt="@displayName" class="profile-avatar__image" />
            }
            else
            {
                <span>@avatarText</span>
            }
        </a>
        <ul class="dropdown-menu dropdown-menu-end glass-menu account-menu">
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Profile</a></li>
            <li><a class="dropdown-item" asp-controller="Checkout" asp-action="History">Purchase history</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item">Logout</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-brand" asp-area="Identity" asp-page="/Account/Register">Join Free</a>
    </li>
}
</ul>
