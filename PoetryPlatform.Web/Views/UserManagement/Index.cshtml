@model IEnumerable<AdminUserVm>

<h2>Users</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>Author Name</th>
            <th>Phone</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@(user.AuthorName ?? "—")</td>
                <td>@(user.PhoneNumber ?? "—")</td>
            </tr>
        }
    </tbody>
</table>
