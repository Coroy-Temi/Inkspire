@model PoetryPlatform.Web.Models.Poem

@{
    ViewData["Title"] = "Edit Writing";
}

<h2>Edit Writing</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Title</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Content</label>
        <textarea asp-for="Content" class="form-control" rows="8"></textarea>
    </div>

    <div class="mb-3">
        <label>Access Type</label>
        <select asp-for="AccessType" class="form-control">
            <option value="Free">Free</option>
            <option value="Paid">Paid</option>
            <option value="External">External</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Price</label>
        <input asp-for="Price" class="form-control" />
    </div>

    <div class="mb-3">
        <label>External Purchase URL</label>
        <input asp-for="ExternalPurchaseUrl" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>
